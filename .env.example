# Copy to .env and fill in. Never commit .env.
# Use one OpenRouter key per phase, each with a credit limit set in the OpenRouter dashboard.
OPENROUTER_API_KEY=
DAYTONA_API_KEY=
# Optional Daytona settings (defaults are fine for most accounts)
# DAYTONA_API_URL=https://app.daytona.io/api   (default; leave unset)
# DAYTONA_TARGET=

AGENTBENCH_RESULTS_DIR=results
# smoke | calibration | dev | eval  (must match the experiment's phase)
AGENTBENCH_PHASE=smoke

# Trials (Daytona sandboxes) running at once; overrides `concurrency` in experiments/*.yaml.
# 10-20 for real runs; keep it within your Daytona plan's concurrent-sandbox / vCPU / RAM limits
# and your OpenRouter rate limits. Leave unset to use the experiment's value (1).
AGENTBENCH_CONCURRENCY=16
